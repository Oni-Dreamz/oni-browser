{
  "name": "oni-browser",
  "version": "1.0.0",
  "description": "Oni Browser - Sleek, fierce, uncompromised web browser for Windows.",
  "main": "src/main/index.js",
  "author": "Oni Lab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "make-ico": "electron scripts/make-ico.js",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.onilab.onibrowser",
    "productName": "Oni Browser",
    "copyright": "Copyright © 2026 Oni Lab",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Oni-Dreamz",
        "repo": "oni-browser"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oni Browser",
      "artifactName": "Oni-Browser-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Oni Browser Standalone.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}

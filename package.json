{
  "name": "oni-browser",
  "version": "1.0.1",
  "description": "Oni Browser - Sleek, fierce, uncompromised web browser for Windows.",
  "main": "src/main/index.js",
  "author": "Oni Lab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "make-ico": "electron scripts/make-ico.js",
    "build:installer": "node --use-system-ca ./node_modules/electron-builder/cli.js --win nsis",
    "build:portable": "node --use-system-ca ./node_modules/electron-builder/cli.js --win portable",
    "build": "node --use-system-ca ./node_modules/electron-builder/cli.js --win nsis"
  },
  "build": {
    "appId": "com.onilab.onibrowser",
    "productName": "Oni Browser",
    "copyright": "Copyright © 2026 Oni Lab",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Oni-Dreamz",
        "repo": "oni-browser",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "protocols": [
      {
        "name": "HTTP",
        "schemes": [
          "http"
        ]
      },
      {
        "name": "HTTPS",
        "schemes": [
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oni Browser",
      "uninstallDisplayName": "${productName}",
      "artifactName": "Oni-Browser-Setup-${version}.${ext}",
      "include": "scripts/installer.nsh"
    },
    "portable": {
      "artifactName": "Oni Browser Standalone.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}

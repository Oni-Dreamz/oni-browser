{
  "name": "oni-browser",
  "version": "1.0.4",
  "description": "Oni Browser - Sleek, fierce, uncompromised web browser for Windows.",
  "main": "src/main/index.js",
  "author": "Oni Lab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "make-ico": "electron scripts/make-ico.js",
    "build:installer": "node scripts/build.js --installer",
    "build:portable": "node scripts/build.js --portable",
    "build:all": "node scripts/build.js --all",
    "build": "node scripts/build.js --installer",
    "clean:dist": "node scripts/clean-dist.js"
  },
  "build": {
    "appId": "com.onilab.onibrowser",
    "productName": "Oni Browser",
    "copyright": "Copyright © 2026 Oni Lab",
    "afterPack": "scripts/afterPack.js",
    "afterSign": "scripts/afterSign.js",
    "afterAllArtifactBuild": "scripts/clean-dist.js",
    "directories": {
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Oni-Dreamz",
        "repo": "oni-browser"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "protocols": [
      {
        "name": "HTTP",
        "schemes": [
          "http"
        ]
      },
      {
        "name": "HTTPS",
        "schemes": [
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oni Browser",
      "uninstallDisplayName": "${productName}",
      "artifactName": "Oni-Browser-Setup-${version}.${ext}",
      "include": "scripts/installer.nsh"
    },
    "portable": {
      "artifactName": "Oni Browser Standalone.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
